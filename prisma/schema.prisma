// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}
model User {
  id            String    @id @default(cuid())
  username      String    @unique
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profile       Profile?
  sentSwipes    Swipe[]   @relation("SentSwipes")
  receivedSwipes Swipe[]  @relation("ReceivedSwipes")
  matchesAsInitiator Match[] @relation("MatchesAsInitiator")
  matchesAsTarget Match[]   @relation("MatchesAsTarget")
  messagesSent  Message[] @relation("MessagesSent")
  messagesReceived Message[] @relation("MessagesReceived")
  photos        Photo[]

  tokens  RefreshToken[]

  @@map("users")
}

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  age         Int
  phone       String?
  gender      Gender
  seeking     Seeking
  bio         String?
  location    String?
  interests   String[] // e.g., ["hiking", "music"]
  latitude    Float?
  longitude   Float?
  updatedAt   DateTime @updatedAt

  @@index([gender])
  @@index([seeking])
  @@index([location])
  @@map("profiles")
}

model Swipe {
  id           String   @id @default(cuid())
  swiperId     String
  swipedId     String
  action       SwipeAction @default(LIKE)
  createdAt    DateTime @default(now())

  swiper       User     @relation("SentSwipes", fields: [swiperId], references: [id], onDelete: Cascade)
  swiped       User     @relation("ReceivedSwipes", fields: [swipedId], references: [id], onDelete: Cascade)

  @@unique([swiperId, swipedId])
  @@index([swipedId])
  @@map("swipes")
}

model Match {
  id           String   @id @default(cuid())
  initiatorId  String
  targetId     String
  createdAt    DateTime @default(now())
  messages     Message[]

  initiator    User     @relation("MatchesAsInitiator", fields: [initiatorId], references: [id], onDelete: Cascade)
  target       User     @relation("MatchesAsTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([initiatorId, targetId])
  @@map("matches")
}

model Message {
  id          String   @id @default(cuid())
  matchId     String?
  senderId    String
  receiverId  String
  content     String
  createdAt   DateTime @default(now())
  readAt      DateTime?

  match       Match?   @relation(fields: [matchId], references: [id])
  sender      User     @relation("MessagesSent", fields: [senderId], references: [id])
  receiver    User     @relation("MessagesReceived", fields: [receiverId], references: [id])

  @@index([matchId])
  @@index([senderId])
  @@index([receiverId])
  @@map("messages")
}

model Photo {
  id        String @id @default(cuid())
  userId    String
  url       String
  isPrimary Boolean @default(false)
  createdAt DateTime @default(now())

  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, isPrimary])
  @@index([userId])
  @@map("photos")
}

model RefreshToken {
  id        String      @id @default(cuid())
  tokenHash String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  revokedAt DateTime?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

enum Role {
  USER
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  NON_BINARY
}

enum Seeking {
  MALE
  FEMALE
  EVERYONE
}

enum SwipeAction {
  LIKE
  PASS
}